def cmd_bootstrap(args, cfg):
    node = get_node(cfg, args.node)
    print(f"bootstrapping {node.name} ({node.target})", flush=True)
    node.out("mkdir -p ~/.local/share/nodes ~/.config/systemd/user")
    node.scp_to(TOOL_DIR / "worker" / "nodes-worker.sh", "~/.local/share/nodes/nodes-worker.sh.new")
    node.scp_to(TOOL_DIR / "worker" / "nodes-worker.service", "~/.config/systemd/user/nodes-worker.service.new")
    r = node.ssh(BOOTSTRAP_SCRIPT, timeout=900, capture=False)
    sys.exit(r.returncode)


def sync_project(node, proj, cfg, with_git=False, delete=False, quiet=False):
    root = Path(cfg["control"].get("projects_root", "~/projects")).expanduser()
    src = root / proj
    if not src.is_dir():
        die(f"{src} is not a directory")
    extra = ["--filter=:- .gitignore", "--exclude", ".venv/"]
    if not with_git:
        extra += ["--exclude", ".git/"]
    if delete:
        extra.append("--delete")
    node.out(f"mkdir -p {shlex.quote(node.projects_root)}/{shlex.quote(proj)}")
    return node.rsync(f"{src}/", f"{node.target}:{node.projects_root}/{proj}/", extra, quiet=quiet)


def cmd_sync(args, cfg):
    node = get_node(cfg, args.node)
    proj = project_name(args.project, cfg)
    code = sync_project(node, proj, cfg, args.with_git, args.delete)
    if code:
        sys.exit(code)
    print(f"synced {proj} -> {node.name}:{node.projects_root}/{proj}")
    if args.env:
        print("uv sync on the node (first time: minutes, downloads torch)")
        r = node.ssh(f'export PATH="$HOME/.local/bin:$PATH"; cd {node.projects_root}/{shlex.quote(proj)} && uv sync 2>&1 | tail -3',
                     timeout=3600, capture=False)
        sys.exit(r.returncode)


def job_script(node, proj, name, command, submitted_from):
    cmd = " ".join(shlex.quote(c) for c in command) if len(command) > 1 else command[0]
    return f"""#!/bin/bash
# nodes job {name} -- submitted {dt.datetime.now():%F %T} from {submitted_from}; project {proj}
export PATH="$HOME/.local/bin:$PATH"
export PYTHONUNBUFFERED=1
cd "$HOME/projects/{proj}" || {{ echo "project directory missing: run 'nodes sync {node.name} {proj}' first"; exit 97; }}
echo "[nodes] start $(date '+%F %T') on $(hostname) in $PWD"
{cmd}
code=$?
echo "[nodes] end $(date '+%F %T') exit $code"
exit $code
"""


def dispatch(node, proj, name, command):
    """Drop a job script into the node's worker queue; returns the remote job id."""
    name = re.sub(r"[^A-Za-z0-9._-]+", "-", name).strip("-") or "job"
    job_id = f"{dt.datetime.now():%Y%m%d-%H%M%S.%f}_{name}"     # microseconds keep the queue order when jobs arrive in the same second
    script = job_script(node, proj, name, command, os.uname().nodename)
    with tempfile.NamedTemporaryFile("w", suffix=".sh", delete=False) as fh:
        fh.write(script)
        tmp = fh.name
    try:
        node.scp_to(tmp, f"{node.jobs_root}/queue/.{job_id}.sh")
        node.out(f"mv {node.jobs_root}/queue/.{job_id}.sh {node.jobs_root}/queue/{job_id}.sh")
    finally:
        os.unlink(tmp)
    return job_id


def cmd_run(args, cfg):
    node = get_node(cfg, args.node)
    proj = project_name(args.project, cfg)
    if not args.command:
        die("give the command after --")
    job_id = dispatch(node, proj, args.name, args.command)
    print(f"queued {job_id} on {node.name}  (log: {node.jobs_root}/log/{job_id}.log;  nodes logs {node.name} {args.name} -f)")


def latest_job(node, name):
    """The newest job id whose name matches, searching done, run and queue."""
    out = node.out(f"ls -1 {node.jobs_root}/queue {node.jobs_root}/run {node.jobs_root}/done {node.jobs_root}/log 2>/dev/null | grep -v '^\\.' | sed 's/\\.\\(sh\\|log\\|done\\|pid\\)$//' | sort -u")
    ids = [l.strip() for l in out.splitlines() if l.strip() and not l.endswith(":")]
    match = [i for i in ids if i == name or i.endswith("_" + name)]
    if not match:
        die(f"no job named {name!r} on {node.name}")
    return sorted(match)[-1]


def cmd_ps(args, cfg):
    node = get_node(cfg, args.node)
    print(node.out(f"""
J={node.jobs_root}
echo "running:"; for f in $J/run/*.sh; do [ -e "$f" ] && echo "  $(basename ${{f%.sh}})  pid $(cat ${{f%.sh}}.pid 2>/dev/null)  since $(date -r $f '+%F %T')"; done
echo "queued:";  ls -1 $J/queue 2>/dev/null | grep -v '^\\.' | sed 's/\\.sh$//; s/^/  /'
echo "recent:";  ls -1t $J/done 2>/dev/null | grep '\\.done$' | head -{args.n} | while read d; do read code secs < $J/done/$d; echo "  ${{d%.done}}  exit $code  ${{secs}}s"; done
tail -1 $J/worker.log 2>/dev/null | sed 's/^/worker: /'
""").rstrip())


def cmd_logs(args, cfg):
    node = get_node(cfg, args.node)
    job = latest_job(node, args.name)
    log = f"{node.jobs_root}/log/{job}.log"
    if args.follow:
        os.execvp("ssh", ["ssh", *SSH_OPTS, "-t", node.target, f"tail -n {args.n} -f {log}"])
    print(node.out(f"tail -n {args.n} {log} 2>/dev/null || echo '(no log yet)'").rstrip())


def cmd_wait(args, cfg):
    node = get_node(cfg, args.node)
    job = latest_job(node, args.name)
    done = f"{node.jobs_root}/done/{job}.done"
    while True:
        out = node.out(f"cat {done} 2>/dev/null || echo pending")
        if out.strip() != "pending":
            code, secs = out.split()[:2]
            print(f"{job} finished: exit {code} after {secs}s")
            sys.exit(int(code))
        time.sleep(args.poll)


def cmd_cancel(args, cfg):
    node = get_node(cfg, args.node)
    job = latest_job(node, args.name)
    print(node.out(f"""
J={node.jobs_root}
if [ -f $J/queue/{job}.sh ]; then rm $J/queue/{job}.sh; echo "removed {job} from the queue"; exit 0; fi
if [ -f $J/run/{job}.pid ]; then pid=$(cat $J/run/{job}.pid)
  tree() {{ local q="$1"; local all=""; while [ -n "$q" ]; do all="$all $q"; q=$(for x in $q; do pgrep -P $x; done | tr '\n' ' '); done; echo $all; }}
  procs=$(tree $pid)                                                            # the job's bash, uv, python, ... (uv may start python in its own group)
  kill -TERM $procs 2>/dev/null
  for i in $(seq 1 30); do alive=""; for x in $procs; do kill -0 $x 2>/dev/null && alive="$alive $x"; done; [ -z "$alive" ] && break; sleep 1; done
  [ -n "$alive" ] && {{ kill -KILL $alive 2>/dev/null; sleep 2; }}
  echo "stopped {job} (processes: $procs)"; exit 0; fi
echo "{job} is not queued or running"
""").rstrip())


def cmd_push(args, cfg):
    node = get_node(cfg, args.node)
    sys.exit(node.rsync(args.local, f"{node.target}:{args.remote}"))


def cmd_pull(args, cfg):
    node = get_node(cfg, args.node)
    Path(args.local).parent.mkdir(parents=True, exist_ok=True)
    sys.exit(node.rsync(f"{node.target}:{args.remote}", args.local))


def cmd_sh(args, cfg):
    node = get_node(cfg, args.node)
    if args.command:
        # one argument is a shell snippet to run as given; several are a command and its arguments
        cmd = args.command[0] if len(args.command) == 1 else " ".join(shlex.quote(c) for c in args.command)
        os.execvp("ssh", ["ssh", *SSH_OPTS, node.target, cmd])
    os.execvp("ssh", ["ssh", *SSH_OPTS, "-t", node.target])


# ------------------------------------------------------------------------------------------------ scheduler
JOBS_DIR = Path("~/.local/share/nodes/jobs").expanduser()
LOST_AFTER_S = 1800


def job_files():
    JOBS_DIR.mkdir(parents=True, exist_ok=True)
    return sorted(JOBS_DIR.glob("*.json"))


def load_job(path):
    return json.loads(path.read_text())


def save_job(job):
    path = JOBS_DIR / f"{job['id']}.json"
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(job, indent=1))
    tmp.replace(path)


def find_job(key):
    jobs = [load_job(p) for p in job_files()]
    match = [j for j in jobs if j["id"] == key or j["name"] == key]
    if not match:
        die(f"no job {key!r} in the control queue")
    return sorted(match, key=lambda j: j["id"])[-1]


def cmd_submit(args, cfg):
    """Put a job in the CONTROL queue; the scheduler places it on a node that fits."""
    if not args.command:
        die("give the command after --")
    proj = project_name(args.project, cfg)
    name = re.sub(r"[^A-Za-z0-9._-]+", "-", args.name).strip("-") or "job"
    job = dict(id=f"{dt.datetime.now():%Y%m%d-%H%M%S.%f}_{name}", name=name, project=proj, command=args.command,
               vram_gb=args.vram, ram_gb=args.ram, data=args.data or [], node=args.node, priority=args.priority,
               pull=[list(p) for p in (args.pull or [])], state="pending", submitted=time.time(), history=[])
    save_job(job)
    print(f"submitted {job['id']} to the control queue (needs vram >= {args.vram} GB, ram >= {args.ram} GB"
          + (f", data {', '.join(job['data'])}" if job["data"] else "") + (f", node {args.node}" if args.node else "") + ")")


def cmd_queue(args, cfg):
    jobs = [load_job(p) for p in job_files()]
    by = {"pending": [], "running": [], "done": [], "failed": [], "lost": []}
    for j in jobs:
        by.setdefault(j["state"], []).append(j)
    for state in ("pending", "running", "lost", "failed", "done"):
        rows = sorted(by.get(state, []), key=lambda j: (-j.get("priority", 0), j["id"])) if state == "pending" else sorted(by.get(state, []), key=lambda j: j["id"])
        if state in ("done", "failed"):
            rows = rows[-args.n:]
        if not rows:
            continue
        print(f"{state}:")
        for j in rows:
            need = f"vram>={j['vram_gb']}G ram>={j['ram_gb']}G" + (f" data={','.join(j['data'])}" if j["data"] else "") + (f" node={j['node']}" if j.get("node") else "")
            where = f" on {j.get('placed_on')} as {j.get('remote_id')}" if j.get("placed_on") else ""
            when = dt.datetime.fromtimestamp(j.get("finished") or j.get("started") or j["submitted"]).strftime("%m-%d %H:%M")
            tail = f" exit {j.get('exit_code')} {j.get('seconds', '')}s" if state in ("done", "failed") else (f" -- {j.get('note', '')}" if j.get("note") else "")
            print(f"  {j['id']:42s} {j['project']:14s} {need:40s}{where} [{when}]{tail}")


def cmd_requeue(args, cfg):
    job = find_job(args.job)
    if job["state"] == "running" and job.get("placed_on"):
        node = get_node(cfg, job["placed_on"])
        try:
            node.out(f"rm -f {node.jobs_root}/queue/{job['remote_id']}.sh")     # still queued there: take it back
        except RuntimeError:
            pass
    job["history"].append(dict(state=job["state"], node=job.get("placed_on"), remote_id=job.get("remote_id"), at=time.time()))
    job.update(state="pending", placed_on=None, remote_id=None, started=None, note="requeued")
    save_job(job)
    print(f"{job['id']} is pending again")


def place(job, node, st, cfg, log):
    """Sync the project, push missing datasets, dispatch to the node's worker."""
    root = Path(cfg["control"].get("projects_root", "~/projects")).expanduser()
    if sync_project(node, job["project"], cfg, quiet=True):
        log(f"  sync of {job['project']} to {node.name} failed; will retry")
        return False
    for d in job["data"]:
        if f"{job['project']}/{d}" not in st["dataset_list"]:
            src = root / job["project"] / d
            if not src.is_dir():
                log(f"  dataset {d} is not on the control PC either; cannot place {job['id']}")
                return False
            log(f"  pushing {d} to {node.name} ({sum(f.stat().st_size for f in src.rglob('*') if f.is_file()) / 1e9:.1f} GB)")
            if node.rsync(f"{src}/", f"{node.target}:{node.projects_root}/{job['project']}/{d}/", quiet=True):
                log("  push failed; will retry")
                return False
    job["remote_id"] = dispatch(node, job["project"], job["name"], job["command"])
    job.update(state="running", placed_on=node.name, started=time.time(), note=None, last_seen=time.time())
    save_job(job)
    log(f"  placed {job['id']} on {node.name} as {job['remote_id']} (queue there was {st['queue_len']}, {'busy' if st['busy'] else 'idle'})")
    return True


def schedule_once(cfg, log=print):
    probes = probe_all(cfg)
    ok = {n: (node, st) for n, (node, st) in probes.items() if "error" not in st and st.get("worker") == "active"}
    for n, (node, st) in probes.items():
        if "error" in st:
            log(f"{n}: {st['error']}")
    jobs = [load_job(p) for p in job_files()]
    # 1. running jobs: finished? lost?
    for job in jobs:
        if job["state"] != "running":
            continue
        n = job["placed_on"]
        if n not in ok:
            if time.time() - job.get("last_seen", job["started"]) > LOST_AFTER_S:
                job.update(state="lost", note=f"{n} unreachable since {dt.datetime.fromtimestamp(job.get('last_seen', job['started'])):%m-%d %H:%M}; nodes requeue {job['name']}")
                save_job(job)
                log(f"  {job['id']}: {job['note']}")
            continue
        node = ok[n][0]
        job["last_seen"] = time.time()
        try:
            out = node.out(f"cat {node.jobs_root}/done/{job['remote_id']}.done 2>/dev/null || echo pending").strip()
        except RuntimeError:
            save_job(job)
            continue
        if out == "pending":
            save_job(job)
            continue
        code, secs = (out.split() + ["0"])[:2]
        job.update(exit_code=int(code), seconds=int(secs), finished=time.time(), state="done" if int(code) == 0 else "failed")
        for remote, local in job.get("pull", []):
            Path(local).parent.mkdir(parents=True, exist_ok=True)
            if node.rsync(f"{node.target}:{remote}", local, quiet=True):
                job["note"] = f"pull of {remote} failed"
        save_job(job)
        log(f"  {job['id']} on {n}: {job['state']} (exit {code}, {secs}s)" + (f"; pulled {len(job.get('pull', []))} path(s)" if job.get("pull") else ""))
    # 2. pending jobs, highest priority then oldest first
    pending = sorted([j for j in jobs if j["state"] == "pending"], key=lambda j: (-j.get("priority", 0), j["id"]))
    load = {n: st["queue_len"] + (1 if st["busy"] else 0) for n, (node, st) in ok.items()}
    for job in pending:
        cands = []
        for n, (node, st) in ok.items():
            if job.get("node") and job["node"] != n:
                continue
            if st["vram_total_gb"] + 1e-6 < job["vram_gb"] or st["ram_total_gb"] + 1e-6 < job["ram_gb"]:
                continue
            has_data = all(f"{job['project']}/{d}" in st["dataset_list"] for d in job["data"])
            # prefer: the data already there, then the shortest queue, then the most free VRAM
            cands.append(((has_data, -load[n], st["vram_free_gb"]), n))
        if not cands:
            reason = "no reachable node fits" if ok else "no node reachable"
            if job.get("note") != reason:              # say it once, not every 30 s
                job["note"] = reason
                save_job(job)
                log(f"  {job['id']}: {reason}")
            continue
        n = max(cands)[1]
        if place(job, ok[n][0], ok[n][1], cfg, log):
            load[n] += 1


def cmd_scheduler(args, cfg):
    if args.install:
        unit = Path("~/.config/systemd/user/nodes-scheduler.service").expanduser()
        unit.parent.mkdir(parents=True, exist_ok=True)
        unit.write_text("[Unit]\nDescription=nodes scheduler: places queued jobs on the compute nodes\nAfter=network-online.target\n\n"
                        "[Service]\nExecStart=%h/.local/bin/nodes scheduler --interval 30\nRestart=always\nRestartSec=10\n\n[Install]\nWantedBy=default.target\n")
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
        subprocess.run(["systemctl", "--user", "enable", "--now", "nodes-scheduler"], check=True)
        subprocess.run(["loginctl", "enable-linger", os.environ.get("USER", "")], check=False)
        print("scheduler installed as the user service nodes-scheduler (journalctl --user -u nodes-scheduler -f)")
        return
    if args.once:
        schedule_once(cfg)
        return
    while True:
        try:
            schedule_once(cfg, log=lambda m: print(f"[{dt.datetime.now():%F %T}] {m}", flush=True))
        except Exception as e:  # noqa: BLE001 -- a scheduler must not die on one bad probe
            print(f"[{dt.datetime.now():%F %T}] scheduler error: {e}", flush=True)
        time.sleep(args.interval)


def cmd_add(args, cfg):
    text = CONFIG.read_text() if CONFIG.exists() else "[control]\nprojects_root = \"~/projects\"\n"
    if f"[nodes.{args.name}]" in text:
        die(f"node {args.name!r} already in {CONFIG}")
    block = f'\n[nodes.{args.name}]\nhost = "{args.host}"\nuser = "{args.user}"\ngpus = {args.gpus}\n'
    if args.note:
        block += f'note = "{args.note}"\n'
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    CONFIG.write_text(text.rstrip("\n") + "\n" + block)
    print(f"added {args.name} ({args.user}@{args.host}) to {CONFIG}; next: nodes bootstrap {args.name}")


def main():
    ap = argparse.ArgumentParser(prog="nodes", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("ls", help="status of every node"); p.add_argument("-v", "--verbose", action="store_true"); p.set_defaults(fn=cmd_ls)
    p = sub.add_parser("bootstrap", help="prepare a new node"); p.add_argument("node"); p.set_defaults(fn=cmd_bootstrap)
    p = sub.add_parser("sync", help="rsync a project's working tree to a node"); p.add_argument("node"); p.add_argument("project", nargs="?")
    p.add_argument("--env", action="store_true", help="run uv sync on the node afterwards"); p.add_argument("--with-git", action="store_true")
    p.add_argument("--delete", action="store_true", help="also delete files the node has and you do not"); p.set_defaults(fn=cmd_sync)
    p = sub.add_parser("run", help="queue a job"); p.add_argument("node"); p.add_argument("name"); p.add_argument("-p", "--project")
    p.add_argument("command", nargs="*", help="after ' -- '"); p.set_defaults(fn=cmd_run)
    p = sub.add_parser("ps", help="jobs on a node"); p.add_argument("node"); p.add_argument("-n", type=int, default=10); p.set_defaults(fn=cmd_ps)
    p = sub.add_parser("logs", help="tail a job's log"); p.add_argument("node"); p.add_argument("name"); p.add_argument("-n", type=int, default=40)
    p.add_argument("-f", "--follow", action="store_true"); p.set_defaults(fn=cmd_logs)
    p = sub.add_parser("wait", help="block until a job is done"); p.add_argument("node"); p.add_argument("name"); p.add_argument("--poll", type=int, default=30); p.set_defaults(fn=cmd_wait)
    p = sub.add_parser("cancel", help="remove a queued job or kill a running one"); p.add_argument("node"); p.add_argument("name"); p.set_defaults(fn=cmd_cancel)
    p = sub.add_parser("push", help="rsync to the node"); p.add_argument("node"); p.add_argument("local"); p.add_argument("remote"); p.set_defaults(fn=cmd_push)
    p = sub.add_parser("pull", help="rsync from the node"); p.add_argument("node"); p.add_argument("remote"); p.add_argument("local"); p.set_defaults(fn=cmd_pull)
    p = sub.add_parser("sh", help="shell or one command on the node"); p.add_argument("node"); p.add_argument("command", nargs=argparse.REMAINDER); p.set_defaults(fn=cmd_sh)
    p = sub.add_parser("submit", help="queue a job for the scheduler to place"); p.add_argument("name"); p.add_argument("-p", "--project")
    p.add_argument("--vram", type=float, default=0.0, help="GB of GPU memory the job needs"); p.add_argument("--ram", type=float, default=0.0, help="GB of RAM")
    p.add_argument("--data", action="append", default=[], metavar="DIR", help="dataset directory (relative to the project) the job needs; pushed if the node lacks it")
    p.add_argument("--pull", nargs=2, action="append", metavar=("REMOTE", "LOCAL"), help="rsync REMOTE (relative to the node's home) to LOCAL when the job is done")
    p.add_argument("--node", help="pin to one node"); p.add_argument("--priority", type=int, default=0)
    p.add_argument("command", nargs="*", help="after ' -- '"); p.set_defaults(fn=cmd_submit)
    p = sub.add_parser("queue", help="the control queue: pending / running / done across nodes"); p.add_argument("-n", type=int, default=10); p.set_defaults(fn=cmd_queue)
    p = sub.add_parser("requeue", help="put a running, lost or failed job back into the control queue"); p.add_argument("job"); p.set_defaults(fn=cmd_requeue)
    p = sub.add_parser("scheduler", help="place queued jobs on nodes (loop, --once, or --install as a service)")
    p.add_argument("--once", action="store_true"); p.add_argument("--install", action="store_true"); p.add_argument("--interval", type=int, default=30); p.set_defaults(fn=cmd_scheduler)
    p = sub.add_parser("add", help="add a node to the inventory"); p.add_argument("name"); p.add_argument("host"); p.add_argument("--user", default=os.environ.get("USER", "esf0"))
    p.add_argument("--gpus", type=int, default=1); p.add_argument("--note", default=""); p.set_defaults(fn=cmd_add)
    argv = sys.argv[1:]
    command = None
    if "--" in argv:                       # everything after "--" is the job's command, whatever it looks like
        i = argv.index("--")
        argv, command = argv[:i], argv[i + 1:]
    args = ap.parse_args(argv)
    if command is not None:
        args.command = command
    elif getattr(args, "command", None) and args.command and args.command[0] == "--":
        args.command = args.command[1:]
    if args.cmd in ("run", "submit") and not getattr(args, "command", None):
        die("put the job's command after ' -- ' (options such as --vram go before it)")
    cfg = load_config() if args.cmd != "add" else (tomllib.loads(CONFIG.read_text()) if CONFIG.exists() else {"control": {}, "nodes": {}})
    try:
        args.fn(args, cfg)
    except subprocess.TimeoutExpired:
        die("timed out talking to the node")
    except RuntimeError as e:
        die(str(e))
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
