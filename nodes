STATUS_SCRIPT = r"""
J=~/jobs
gpu=$(nvidia-smi --query-gpu=name,memory.used,memory.total,utilization.gpu --format=csv,noheader 2>/dev/null | head -1 | sed 's/, */ | /g')
[ -n "$gpu" ] || gpu="no GPU"
vram=$(nvidia-smi --query-gpu=memory.total,memory.used --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ')
ram=$(free -m | awk '/Mem/ {print $2","$7}')
worker=$(systemctl --user is-active nodes-worker 2>/dev/null || echo unknown)
q=$(ls $J/queue 2>/dev/null | grep -v '^\.' | wc -l)
run=$(ls $J/run 2>/dev/null | grep '\.sh$' | sed 's/\.sh$//' | head -1)
disk=$(df -h ~ | awk 'NR==2 {print $4 " free"}')
load=$(cut -d' ' -f1 /proc/loadavg)
projects=$(ls -d ~/projects/*/ 2>/dev/null | xargs -n1 basename 2>/dev/null | paste -sd,)
datasets=$(for p in ~/projects/*/; do for d in "$p"data_*/; do [ -d "$d" ] && echo "$(basename $p)/$(basename $d)"; done; done 2>/dev/null | paste -sd,)
echo "gpu=$gpu"; echo "vram=${vram:-0,0}"; echo "ram=$ram"; echo "worker=$worker"; echo "queue=$q"; echo "running=${run:-idle}"; echo "disk=$disk"; echo "load=$load"
echo "projects=$projects"; echo "datasets=$datasets"
"""


def probe_all(cfg, timeout=30):
    """Status of every node in parallel: {name: (node, status dict or {'error': ...})}."""
    nodes = [Node(n, s, cfg) for n, s in cfg["nodes"].items()]

    def probe(node):
        try:
            out = node.out(STATUS_SCRIPT, timeout=timeout)
            st = dict(l.split("=", 1) for l in out.strip().splitlines() if "=" in l)
            vt, vu = (st.get("vram", "0,0").split(",") + ["0"])[:2]
            rt, ra = (st.get("ram", "0,0").split(",") + ["0"])[:2]
            st.update(vram_total_gb=float(vt or 0) / 1024, vram_free_gb=(float(vt or 0) - float(vu or 0)) / 1024,
                      ram_total_gb=float(rt or 0) / 1024, ram_free_gb=float(ra or 0) / 1024,
                      project_list=[x for x in st.get("projects", "").split(",") if x], dataset_list=[x for x in st.get("datasets", "").split(",") if x],
                      queue_len=int(st.get("queue", "0") or 0), busy=st.get("running", "idle") != "idle")
            return node, st
        except subprocess.TimeoutExpired as e:
            err = (e.stderr or b"").decode() if isinstance(e.stderr, bytes) else (e.stderr or "")
            if "Tailscale SSH requires" in err or "login.tailscale.com" in err:
                link = next((w for w in err.split() if w.startswith("https://login.tailscale.com")), "")
                return node, {"error": f"waiting for Tailscale SSH approval: open {link} (set the SSH rule to accept, see ~/docs/nodes.md)"}
            return node, {"error": "timed out (SSH hangs; Tailscale check pending or host down)"}
        except Exception as e:  # noqa: BLE001
            msg = str(e).strip().splitlines()[-1] if str(e).strip() else "unreachable"
            return node, {"error": msg[:100]}

    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
        return {node.name: (node, st) for node, st in ex.map(probe, nodes)}


def cmd_ls(args, cfg):
    if not cfg["nodes"]:
        die("no nodes in the inventory yet (nodes add NAME HOST)")
    for node, st in probe_all(cfg).values():
        if "error" in st:
            print(f"{node.name:12s} {node.target:32s} UNREACHABLE ({st['error']})")
            continue
        print(f"{node.name:12s} {node.target:32s} worker {st['worker']:8s} {st['running']:28s} queue {st['queue']:>2s}  "
              f"load {st['load']:>5s}  {st['disk']:12s}  {st['gpu']}")
        if args.verbose and node.spec.get("note"):
            print(f"{'':12s} {node.spec['note']}")


